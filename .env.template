# Forge — Environment Variables
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=postgresql://forge:forge@postgres:5432/forge

# --- Redis (Celery broker & result backend) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=change-me-to-a-random-32-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# --- OpenAI ---
# Required for hypothesis interview and code generation.
# Without this key, Forge falls back to stubs (dev mode).
OPENAI_API_KEY=

# --- Market Data ---
# Optional: Polygon.io for real-time data beyond ES/NQ.
POLYGON_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
